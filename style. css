body {
font-family: Arial, sans-serif;
background: #121212;
color: white;
display: flex;
justify-content: center;
align-items: center;
min-height: 100vh;
margin: 0;
padding: 10px;
box-sizing: border-box;
}

.chat-container {
width: 100%;
max-width: 350px;
height: 500px;
background: #1e1e1e;
border-radius: 12px;
padding: 15px;
display: flex;
flex-direction: column;
box-sizing: border-box;
}

h2 {
text-align: center;
color: #00d4ff;
}

#messages {
flex: 1;
overflow-y: auto;
margin-bottom: 10px;
}

.message {
background: #333333;
padding: 10px;
border-radius: 8px;
margin: 8px 0;
overflow-wrap: anywhere;
}

.input-area {
display: flex;
gap: 5px;
}

input {
flex: 1;
min-width: 0;
padding: 10px;
border-radius: 5px;
border: none;
outline: none;
}

button {
padding: 10px;
background: #00a8cc;
color: white;
border: none;
border-radius: 5px;
cursor: pointer;
}

button:hover {
background: #0088aa;
}

@media (max-width: 400px) {
.chat-container {
height: 85vh;
}
}